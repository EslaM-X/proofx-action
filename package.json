{
  "name": "proofx-action",
  "version": "0.3.0",
  "private": true,
  "description": "GitHub Action for ProofX evidence verification",
  "main": "src/index.js",
  "scripts": {
    "build": "ncc build src/index.js -o dist --source-map --license licenses.txt",
    "test": "node --test test/*.test.js",
    "lint": "standard src/*.js test/*.js",
    "all": "npm run lint && npm run test && npm run build"
  },
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/tool-cache": "^2.0.1",
    "@actions/artifact": "^2.3.2"
  },
  "devDependencies": {
    "@vercel/ncc": "^0.38.3",
    "standard": "^17.1.2"
  },
  "license": "MIT"
}
